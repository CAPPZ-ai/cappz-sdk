{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@cappz/sdk/*": [
        "./packages/cappz-sdk/*"
      ]
    }
  },
  "include": [
    "src",
    "packages/cappz-sdk"
  ]
}
