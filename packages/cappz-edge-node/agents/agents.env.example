# Paid agents, mainnet instance (real XRP). Copy to agents.env. Public payout address only, never a seed.
CAPPZ_AGENT_PAYTO=rYourPayoutAddress
CAPPZ_AGENT_NETWORK=mainnet
CAPPZ_AGENT_PORT=41460
CAPPZ_AGENT_PUBLIC_BASE=https://node.example.com/agents
CAPPZ_AGENT_PEER_BASE=https://node.example.com/testnet/agents
CAPPZ_TIMESTAMP_PRICE_XRP=0.05
CAPPZ_WEBHOOK_PRICE_XRP=2
CAPPZ_WEBHOOK_DAYS=30
# Fair draw (15.47.0): price, how far ahead a draw may be, and the least time between commitment and draw.
CAPPZ_DRAW_PRICE_XRP=0.1
CAPPZ_DRAW_MAX_DAYS=30
CAPPZ_DRAW_MIN_LEAD_SECONDS=120
# Vault check and vault guard (15.49.0). The guard also needs CAPPZ_VAULT_GUARD_SECRET in node.env (32 random bytes, hex;
# both instances share it): each customer vault's guard key is derived from it. Back it up with node.env. Unset = no guard.
CAPPZ_VAULT_CHECK_PRICE_XRP=1
CAPPZ_VAULT_GUARD_PRICE_XRP=10
CAPPZ_VAULT_GUARD_DAYS=30
# CAPPZ_VAULT_RECONCILE_SECONDS=600   (how often an active guard reconciles its vault)
# 15.47.0: the agents find the payout account's on-ledger declarations of the node key themselves (no file to copy).
# CAPPZ_KEYZ_ACCOUNT=<defaults to CAPPZ_AGENT_PAYTO>
# CAPPZ_KEYZ_NETWORK=mainnet
# CAPPZ_KEYZ_DISCOVER=0   (turns it off)
# Optional (run-agents.ps1 sets it when <node folder>\data\key-declarations.json exists): the wallet-signed KeyZ declaration of the
# node key, made with tools/declare-node-key.ts. With it, every record names the wallet that vouches for the signer.
# CAPPZ_NODE_KEY_DECLARATIONS=C:\path\to\cappz-edge-node\data\key-declarations.json
# Jobs and results, one folder per network, inside <node folder>\agents\data.
CAPPZ_AGENT_DATA=C:\path\to\cappz-edge-node\agents\data\mainnet
