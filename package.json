{
  "name": "@cappz/sdk",
  "version": "15.42.0",
  "description": "CAPPZ SDK: local-first wallet storage, sync, skills, governance and RepoZ; move a PHP app off php-fpm route by route; KeyZ trust and KeyZ Gate; edge transports through firewalls; paid agents and usage billing with a subscription agent; the CAPPZ edge node; a resilience mesh (phones and laptops carrying each other's traffic when the internet is down).",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CAPPZ-ai/cappz-sdk"
  },
  "homepage": "https://cappz.ai",
  "bin": {
    "cappz-market": "./packages/cappz-market/dist/cappz-market.mjs"
  },
  "exports": {
    "./port": "./packages/cappz-sdk/port.ts",
    "./identity": "./packages/cappz-sdk/identity.ts",
    "./edge": "./packages/cappz-sdk/edge.ts",
    "./transports": "./packages/cappz-sdk/transports.ts",
    "./paidAgent": "./packages/cappz-sdk/paidAgent.ts",
    "./skills": "./packages/cappz-sdk/skills.ts",
    "./sync": "./packages/cappz-sdk/sync.ts",
    "./governance": "./packages/cappz-sdk/governance.ts",
    "./repoz": "./packages/cappz-sdk/repoz.ts",
    "./mesh": "./packages/cappz-sdk/mesh.ts",
    "./marketplace": "./packages/cappz-sdk/marketplace.ts",
    "./network": "./packages/cappz-sdk/network.ts",
    "./constraints": "./packages/cappz-sdk/constraints.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mesh": "vite-node packages/cappz-mesh-node/main.ts --",
    "mesh:kit": "vite-node packages/cappz-mesh-node/main.ts -- kit-build",
    "market:build": "node packages/cappz-market/build.mjs && vite-node packages/cappz-market/write-docs.ts",
    "native:bench": "vite-node packages/cappz-native/bench/sdk-bench.ts",
    "validate:token-stage": "vite-node tools/validate-token-stage.ts --"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.2.0",
    "@scure/bip39": "^2.4.0",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "xrpl": "^4.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.7.9",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
